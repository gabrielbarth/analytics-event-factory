{
  "name": "analytics-event-factory",
  "description": "Analytics Event Factory",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "event",
    "events",
    "event emitter",
    "event factory",
    "event with metadata",
    "analytics event factory",
    "amplitude analytics events",
    "firebase analytics events",
    "user events",
    "custom user events",
    "users event with metadata"
  ],
  "author": "Gabriel Barth (dev@gabrielbarth.com)",
  "license": "ISC",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.25.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.5.5",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "publint": "^0.3.25",
    "ts-jest": "^29.3.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielbarth/analytics-event-factory.git"
  }
}
